{

  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // "source": "/home/jegor/.config/fastfetch/arch.png",
    "type": "small",
    "color": {"1": "#f57256"},
    "color": {"2": "#f57256"},
    "padding": {
      "top": 6
    }
  },

"modules": [
        
        /* где-то нужен "title" */

        "break",    

        {
            "type": "custom",
            "format": "╭──────────────────────Hardware──────────────────────╮",
            "outputColor": "#f57256"
        },

        {
            "type": "host",
            "key": " PC",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "cpu",
            "key": "│ ├",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "memory",
            "key": "│ ├󰍛",            
            "keyColor": "#7f7f7f"
        },

        {
            "type": "disk",
            "key": "╰ ╰",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "custom",
            "format": "╰────────────────────────────────────────────────────╯",
            "outputColor": "#f57256"
        },

        "break",

        {
            "type": "custom",
            "format": "╭──────────────────────Software──────────────────────╮",   /* \u001b[37m - white \u001b[36m - cyan */
            "outputColor": "#f57256"
        },

        {
            "type": "os",
            "key": " OS",    /* "key": " OS", */
            "keyColor": "#7f7f7f"
        },

        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "shell",
            "key": "╰ ╰",
            "keyColor": "#7f7f7f"
        },

        "break",

        {
            "type": "wm",
            "key": " WM",    /* "key": " WM", "key": "│ ├", "key": " WM", */
            "keyColor": "#7f7f7f"
        },
        
        {
            "type": "icons",
            "key": "│ ├󰉼",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "terminal",
            "key": "╰ ╰",
            "keyColor": "#7f7f7f"
        },

        {
            "type": "custom",
            "format": "╰────────────────────────────────────────────────────╯",
            "outputColor": "#f57256"
        },

        {
            "type": "colors",
            "paddingLeft": 20,
            "symbol": "circle"
        }

  ]

}
