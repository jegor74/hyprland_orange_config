// ============= general ============= 
{
    "position": "top",
    "margin-top" : 10,
    "margin-left": 10,
    "margin-right": 10,
    "height" : 38,


    "modules-left": [
        // "tray",
        "custom/arch",
        "custom/separator",
        "clock"
    ],


    "modules-center": [
        "hyprland/workspaces"
    ],


    "modules-right": [
        "pulseaudio",
        "custom/separator",
        "hyprland/language",
        "custom/separator",
        "battery",
        "custom/separator",
        "network",
        "custom/separator",
        "custom/power"
    ],
// =================================== 

// ============ separators ============
    "custom/separatorpow": {
        "format": " |", 
        "tooltip": false
    },

    "custom/separator": {
        "format": " ",
        "tooltip": false
    },
// ====================================


// ============== modules ==============
    "custom/arch": {
        "format": "󰌪",  // 
        "interval": "once",
        "tooltip": false
    },

    "clock": {
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format": "{:%a  %H:%M:%S  %d.%m.%Y}",                    //12:00:00   01.01.2026
        //"format": "{:%a %H:%M:%S   %B %d}",                     //12:00:00   January 01
        "interval": 1
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5,                  // 5 workspaces by default on every monitor
            "HDMI-A-1": 3            // but only three on HDMI-A-1
        }
    },

    "pulseaudio": {
        "format": " {icon} ",
        "format-muted": "  ",
        "format-icons": {
            "default": ["", "", "🔊"]
        },
        "on-click": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "{volume}%"
    },

    "hyprland/language": {
        "format": " {} ",       //
        "format-en": "US",
        "format-ru": "RU"
        //"on-click": "grp:alt_shift_toggle"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": " {capacity}% ",
        "format-charging": " {capacity}% ",
        "format-plugged": "   {capacity}% ",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },

    "network": {
        "format-wifi": "   ",
        "format-ethernet": "{cidr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "  ⚠  ",
        "tooltip": true,
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}" 
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "/bin/powermenu.sh",
        "tooltip": false
    },
// =====================================

// ========== non-use modules ==========
    "cpu": {
        "format": " {usage}% ",     //" {usage}%"
        "tooltip": true,
        "tooltip-format": "Total"
    },

    "memory": {
        "format": "{}% "
    },

    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C ",
        "format-icons": ["", "", ""]
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 35,
        "rewrite": {
            "": "Arch Linux"
        },

        "separate-outputs": true
    },

    "tray": {
        "incon-size": 16,
        "spacing": 10,
        "icons": {
            "nm-applenst": "Addwaita"
        }
    }
// =====================================
}
